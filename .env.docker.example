# Copy to .env.docker (git-ignored) and replace EVERY value. Generate secrets with: openssl rand -hex 32
APP_ORIGINS=https://staging.example.com
COOKIE_SECURE=true
POSTGRES_ADMIN_PASSWORD=
DB_NAME=hms
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_SYSTEM_PASSWORD=
JWT_SECRET=
PLATFORM_JWT_SECRET=
CSRF_SECRET=
# local (Docker volume) or s3 (private bucket – recommended for staging/production)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Demo accounts (staging only). Leave empty to generate random passwords (printed to the seed container's credentials file).
DEMO_PASSWORD_PLATFORM=
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_TEACHER=
DEMO_PASSWORD_STUDENT=
