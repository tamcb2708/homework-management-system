{
  "name": "homework-management-system",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "dev:api": "pnpm --filter @hms/api dev",
    "dev:web": "pnpm --filter @hms/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @hms/api test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:setup": "bash scripts/db-setup.sh",
    "seed:demo": "pnpm --filter @hms/api seed:demo"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
