# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CSRF Origin check)
APP_ORIGINS=http://localhost:3000
# true when served over HTTPS (cookies get Secure + __Host- prefix)
COOKIE_SECURE=false
LOG_LEVEL=info

# ── Database (three roles, see docs/architecture.md §3.6) ─
DB_NAME=hms
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_SYSTEM_PASSWORD=change-me-system
DATABASE_URL=postgresql://hms_app:change-me-app@localhost:5432/hms
DATABASE_SYSTEM_URL=postgresql://hms_system:change-me-system@localhost:5432/hms
MIGRATION_DATABASE_URL=postgresql://hms_owner:change-me-owner@localhost:5432/hms
# Optional: admin connection used only by scripts/db-setup.sh to create roles/database
# ADMIN_DATABASE_URL=postgresql://postgres:...@localhost:5432/postgres

# ── Auth (generate with: openssl rand -base64 48) ────────
JWT_SECRET=change-me-tenant-realm-secret-at-least-32-chars
PLATFORM_JWT_SECRET=change-me-platform-realm-secret-at-least-32-chars
CSRF_SECRET=change-me-csrf-secret-at-least-32-chars

# ── File storage ─────────────────────────────────────────
# local: private directory on disk, served only through the API after permission checks
# s3   : any S3-compatible bucket (private); downloads use short-lived signed URLs
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hms-staging
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ── AI grading (DISABLED until official approval – decision D11) ──
AI_PROVIDER=disabled
AI_GRADING_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=   (never set until approval; worker/back-end secret only)

# ── Demo seed (staging only, never production) ───────────
# Leave empty to generate random passwords; they are written to .demo-credentials.local (git-ignored).
DEMO_PASSWORD_PLATFORM=
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_TEACHER=
DEMO_PASSWORD_STUDENT=
