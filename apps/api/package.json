{
  "name": "@hms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:int": "jest --runInBand --selectProjects integration",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "create:platform-admin": "node dist/scripts/create-platform-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "argon2": "~0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "~0.14.4",
    "cookie-parser": "~1.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "multer": "^2.5.0",
    "nestjs-pino": "4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
