# Single-container image for Render (free plan): API (NestJS) + web (Next.js) in one service.
# The web server listens on $PORT (set by Render) and proxies /api/* to the API on 127.0.0.1:4000,
# so the browser only ever talks to one HTTPS origin. Database: Neon (or any PostgreSQL 16+).
# Build from the repository root:  docker build -f Dockerfile.render -t hms-render .
FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates postgresql-client \
  && rm -rf /var/lib/apt/lists/* && corepack enable
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @hms/api... --filter @hms/web...
COPY apps/api apps/api
COPY apps/web apps/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd apps/api && npx prisma generate && npx nest build
RUN cd apps/web && npx next build

FROM base AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/api /app/apps/api
COPY --from=build /app/apps/web/.next/standalone /srv/web
COPY --from=build /app/apps/web/.next/static /srv/web/apps/web/.next/static
COPY scripts /app/scripts
RUN mkdir -p /app/apps/api/storage && chown -R node:node /app/apps/api/storage && chmod +x /app/scripts/render-start.sh
USER node
WORKDIR /app/apps/api
EXPOSE 10000
CMD ["/app/scripts/render-start.sh"]
